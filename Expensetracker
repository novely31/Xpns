<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daybook — Personal Finance</title>
  <style>
    :root { --ink: #18231f; --muted: #7c8781; --line: #e8ece8; --surface: #fff; --page: #f5f7f4; --green: #278567; --red: #cf655e; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--page); color: var(--ink); padding: 20px; }
    .app { max-width: 800px; margin: 0 auto; }
    .card { background: var(--surface); padding: 24px; border-radius: 16px; border: 1px solid var(--line); margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 20px; }
    .stat { text-align: center; }
    .amount { font-size: 20px; font-weight: 700; margin-top: 5px; }
    button { cursor: pointer; padding: 10px 16px; border-radius: 8px; border: none; font-weight: 600; margin-top: 5px; }
    .btn-primary { background: var(--green); color: white; width: 100%; }
    .btn-del { background: #fff0ee; color: var(--red); padding: 4px 8px; font-size: 12px; }
    .field { margin-bottom: 15px; }
    input, select { width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 8px; box-sizing: border-box; }
    .tx-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .tx-date { font-size: 11px; color: var(--muted); display: block; }
  </style>
</head>
<body>
  <main class="app">
    <h1>Daybook</h1>
    
    <div class="grid">
      <div class="card stat"><div>Income</div><div id="incTotal" class="amount">₱0.00</div></div>
      <div class="card stat"><div>Expenses</div><div id="expTotal" class="amount">₱0.00</div></div>
      <div class="card stat"><div>Balance</div><div id="balTotal" class="amount">₱0.00</div></div>
    </div>

    <div class="card">
      <h2>Add Transaction</h2>
      <form id="txForm">
        <select id="type"><option value="income">Income</option><option value="expense">Expense</option></select>
        <div class="field"><input type="text" id="desc" placeholder="Description" required></div>
        <div class="field"><input type="number" id="amt" placeholder="Amount (PHP)" step="0.01" required></div>
        <div class="field"><input type="date" id="date" required></div>
        <button type="submit" class="btn-primary">Add Transaction</button>
      </form>
    </div>

    <div class="card">
      <h3>Data Management</h3>
      <button onclick="exportData()">Export Data</button>
      <input type="file" id="importFile" style="display:none" onchange="importData(event)">
      <button onclick="document.getElementById('importFile').click()">Retrieve (Import)</button>
      <button onclick="clearData()" style="color:var(--red)">Clear All</button>
    </div>

    <div class="card">
      <h3>Recent Transactions</h3>
      <ul id="list" style="list-style:none; padding:0"></ul>
    </div>
  </main>

  <script>
    const STORAGE_KEY = 'daybook_data';
    let transactions = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    document.getElementById('date').valueAsDate = new Date();

    function formatPHP(num) { return new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(num); }

    function update() {
      const inc = transactions.filter(t => t.type === 'income').reduce((s, t) => s + t.amt, 0);
      const exp = transactions.filter(t => t.type === 'expense').reduce((s, t) => s + t.amt, 0);
      document.getElementById('incTotal').textContent = formatPHP(inc);
      document.getElementById('expTotal').textContent = formatPHP(exp);
      document.getElementById('balTotal').textContent = formatPHP(inc - exp);
      
      const list = document.getElementById('list');
      list.innerHTML = transactions.slice().reverse().map(t => `
        <li class="tx-item">
          <div><strong>${t.desc}</strong><span class="tx-date">${t.date}</span></div>
          <div>
            <span style="color:${t.type==='income'?'var(--green)':'var(--red)'}">${t.type==='income'?'+':'-'}${formatPHP(t.amt)}</span>
            <button class="btn-del" onclick="deleteTx('${t.id}')">Delete</button>
          </div>
        </li>`).join('');
      localStorage.setItem(STORAGE_KEY, JSON.stringify(transactions));
    }

    function deleteTx(id) {
      if(confirm('Delete this transaction?')) {
        transactions = transactions.filter(t => t.id !== id);
        update();
      }
    }

    function exportData() {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([JSON.stringify(transactions)], {type:'application/json'}));
      a.download = 'daybook-backup.json';
      a.click();
    }

    function importData(e) {
      const reader = new FileReader();
      reader.onload = (event) => {
        transactions = JSON.parse(event.target.result);
        update();
      };
      reader.readAsText(e.target.files[0]);
    }

    function clearData() { if(confirm('Clear all data?')) { transactions = []; update(); } }

    document.getElementById('txForm').onsubmit = (e) => {
      e.preventDefault();
      transactions.push({
        id: Date.now().toString(),
        type: document.getElementById('type').value,
        desc: document.getElementById('desc').value,
        amt: parseFloat(document.getElementById('amt').value),
        date: document.getElementById('date').value
      });
      update();
      e.target.reset();
      document.getElementById('date').valueAsDate = new Date();
    };

    update();
  </script>
</body>
</html>
